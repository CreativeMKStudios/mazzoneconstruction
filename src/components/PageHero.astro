---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  kicker?: string;
  title: string;
  lede: string;
}
const { image, alt, kicker, title, lede } = Astro.props;
---

<section class="page-hero">
  <Image
    src={image}
    alt={alt}
    class="page-hero-media"
    widths={[640, 960, 1280, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="page-hero-copy">
    {kicker && <p class="kicker light">{kicker}</p>}
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
  </div>
</section>
