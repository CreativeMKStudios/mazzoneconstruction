---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ReviewList from '../components/ReviewList.astro';
import { business, photos, reviewNodes, reviews } from '../data/site';

const title = 'Google reviews';
const description =
  'Mazzone Construction has a 5.0 rating from 20 Google reviews. Read the reviews we could source, in the words clients used.';
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: business.url },
    { '@type': 'ListItem', position: 2, name: 'Reviews', item: `${business.url}/reviews` },
  ],
};
---

<Base title={title} description={description} schema={[crumbs, ...reviewNodes()]}>
  <PageHero
    image={photos.gardenWall.src}
    alt={photos.gardenWall.alt}
    kicker="Reviews"
    title="5.0 from 20 Google reviews."
    lede="Spelling is left as it was written. We have not added praise that nobody posted."
  />
  <section class="section">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a> / Reviews</p>
      <p class="lede">
        Google currently shows {business.reviewCount} reviews, all five stars. Below are the {reviews.length} we could read in full from the listing and from pages that quote it. The rest are on the{' '}
        <a href={business.maps}>Google profile</a>.
      </p>
      <div style="height:18px;"></div>
      <ReviewList items={reviews} />
    </div>
  </section>
</Base>
