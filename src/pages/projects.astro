---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { business, photos, projects } from '../data/site';

const title = 'Project photos';
const description =
  'Stone houses, brick repairs, a fireplace, a garden wall, and a downstairs shower room by Mazzone Construction in Kettering.';
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: business.url },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: `${business.url}/projects` },
  ],
};
---

<Base title={title} description={description} schema={[crumbs]}>
  <PageHero
    image={photos.newBuildSite.src}
    alt={photos.newBuildSite.alt}
    kicker="Projects"
    title="The photos, without a made-up story."
    lede="These are the pictures from the Mazzone Google profile and the old site gallery. Captions say what is in the frame."
  />
  <section class="section">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a> / Projects</p>
      <div class="pair">
        <figure>
          <Image src={photos.showerBefore.src} alt={photos.showerBefore.alt} widths={[480, 800]} sizes="(min-width: 800px) 45vw, 100vw" />
          <figcaption>{photos.showerBefore.caption}</figcaption>
        </figure>
        <figure>
          <Image src={photos.showerAfter.src} alt={photos.showerAfter.alt} widths={[480, 800]} sizes="(min-width: 800px) 45vw, 100vw" />
          <figcaption>{photos.showerAfter.caption}</figcaption>
        </figure>
      </div>
      <div class="gallery" style="margin-top:12px;">
        {
          projects
            .filter((item) => item.key !== 'showerBefore' && item.key !== 'showerAfter')
            .map((item, index) => (
              <figure class:list={{ wide: index === 0 }}>
                <Image
                  src={photos[item.key].src}
                  alt={photos[item.key].alt}
                  widths={[540, 900, 1400]}
                  sizes={index === 0 ? '(min-width: 900px) 66vw, 100vw' : '(min-width: 900px) 33vw, 100vw'}
                />
                <figcaption>
                  <strong>{item.title}.</strong> {item.text}
                </figcaption>
              </figure>
            ))
        }
      </div>
      <p class="note" style="margin-top:22px;">
        We have not invented project names or street addresses. If you want the full set on Google, it is on the{' '}
        <a href={business.maps}>Mazzone Construction profile</a>.
      </p>
    </div>
  </section>
</Base>
